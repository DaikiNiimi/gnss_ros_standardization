# ROS 2 / colcon build artifacts
build/
install/
log/
# Sanitizer / warning-audit build trees (colcon --build-base / --install-base)
build-*/
install-*/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
!*Config.cmake
!*ConfigVersion.cmake
!cmake/*.cmake

# Compiled objects
*.o
*.so
*.a
*.dylib

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Compile commands (editor convenience, not source)
compile_commands.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Example runtime output (gnss_imu_kalman_filter CSV logs, written to cwd)
ekf_sensors_log.csv
ekf_state_log.csv

# Generated evaluation rosbags (e.g. PPC-Dataset -> ROSBAG; large, non-committed)
data/
# Independently versioned, accepted PPC bags and dataset provenance.
/PPC-Dataset-ROS2/

# rosbag_to_rinex writes to the current directory
output.obs
output.nav

# The PPC evaluation harness lives in its own repository: it depends on a
# dataset this package cannot redistribute, and it is versioned with the paper
# rather than with the code. The unit tests and the bag verification tools in
# test/ ARE part of the release.
test/ppc_eval/

# Internal working notes and the evaluation ledger. Not release artifacts.
HANDOVER.md
PLAN.md
report.md
AUDIT.md
EVAL_LEDGER.md

# Merge/patch leftovers must never reach a release: install(DIRECTORY include/)
# copies the whole directory, so a stray .orig header would be installed.
*.orig
*.rej

# Local site configuration for the pipeline launch files (credentials, device
# paths). config/site.yaml ships as the template; *.local.yaml is yours.
config/site*.local.yaml

# Optional, test-only Rust reference build products. Keep Cargo.lock tracked.

# Private review plans and historical acceptance ledgers (kept in the workspace).
/RELIABILITY.md
/GENERALIZATION_PLAN.md
/COMMIT_PLAN.md
/REVIEW_PLAN.md
/AUDIT_EVIDENCE.md
/docs/REVIEW_FIXES_20261025.md
/docs/FINAL_ACCEPTANCE_20261027.md
/docs/history/
